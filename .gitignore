# macOS
.DS_Store

# SwiftPM scratch dirs (each worker/build uses its own --scratch-path) and the assembled app
.build*/
build/
# Release packages from scripts/package_release.sh (published as GitHub Release assets).
# Anchored: an unanchored dist/ would also ignore new skins in the tracked skins/dist/.
/dist/
*.xcodeproj/
.swiftpm/

# Python
__pycache__/
*.pyc

# Skin build intermediates. The shipped skins are skins/dist/*.wsz (tracked);
# loose sheets, previews and critique crops are regenerated by `python3 skins/build.py <name>`.
skins/*/out/
skins/*/preview/
skins/*/critique/

# Icon intermediates. assets/Tokenamp.icns (tracked) is regenerated by scripts/make_icon.py.
assets/Tokenamp.iconset/
assets/icon/preview_sizes.png

# Art-critique intermediates: swatch sheets and zoom crops regenerated by each
# skin's swatches.py / crop.py / specimen.py.
skins/*/work/
skins/*/crops/

# agent worktrees
.claude/worktrees/
